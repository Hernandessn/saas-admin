# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# SQLite (default, zero setup, good for local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production, uncomment and set provider="postgresql" in schema.prisma):
# DATABASE_URL="postgresql://user:password@localhost:5432/saas_admin?schema=public"

# --- Auth / JWT ---
# Use long random strings in real environments, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie name used to store the refresh token (httpOnly)
REFRESH_COOKIE_NAME=saas_admin_rt
